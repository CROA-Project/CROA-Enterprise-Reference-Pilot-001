# Copy to .env and replace BOTH secrets with random values of at least 12 characters.
# Placeholders are rejected at startup.  e.g.  python -c "import secrets; print(secrets.token_urlsafe(24))"
DEMO_CONTROL_SECRET=replace-me
INTERNAL_SERVICE_SECRET=replace-me

# Execution Change Contract lifetime (seconds). Caller-supplied TTLs are honoured only in test mode.
ECC_TTL_SECONDS=300

# ECC issuer / audience binding (must match between croa_plane and c6_firewall)
ECC_ISSUER=croa-plane-pilot
ECC_AUDIENCE=c6-firewall-pilot
